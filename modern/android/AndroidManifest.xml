<?xml version="1.0" encoding="utf-8"?>
<!-- D2Next for Android: D2NextActivity extends SDLActivity and loads libSDL3.so and libmain.so
     (the game, src/PlatformAndroid.cpp). Built by build-apk.sh. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.d2next.game"
    android:versionCode="5"
    android:versionName="0.5"
    android:installLocation="auto">

    <!-- Vibration on hits and level-ups (the Esc menu's options can turn it off). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- TCP/IP games (OTHER MULTIPLAYER, src/Lan.cpp): hosting and joining over the local network. Both are granted at
         install, without asking. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The low-latency Wi-Fi lock held during a TCP/IP game (src/PlatformSdl.cpp, lowLatencyNetwork). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- The renderer is OpenGL ES 3.0 (src/GlBackend.cpp). -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />

    <!-- allowNativeHeapPointerTagging: Android tags heap pointers in their top byte, which makes them negative as
         numbers. Storm's lists (external/squall/storm/list) mark their end with an inverted pointer and treat any
         value <= 0 as that mark, as the original game did, so they need plain pointers. -->
    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowNativeHeapPointerTagging="false"
        android:allowBackup="false"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
        android:enableOnBackInvokedCallback="false"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true">

        <activity android:name="org.d2next.game.D2NextActivity"
            android:label="@string/app_name"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
